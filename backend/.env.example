# ==========================================================
# DESCO Smart Prepaid Monitor - Backend Environment Settings
# Database: desco1 (MySQL 8.0+)
# ==========================================================

# MySQL ডাটাবেজ কানেকশন সেটিংস
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=rabbi1067
MYSQL_DATABASE=desco1

# সরাসরি SQLAlchemy ডাটাবেজ URL (ঐচ্ছিক, স্বয়ংক্রিয়ভাবে প্রস্তুত হয়)
# DATABASE_URL=mysql+pymysql://root:rabbi1067@localhost:3306/desco1?charset=utf8mb4

# সিকিউরিটি এবং JWT টোকেন সাইনিং কি
JWT_SECRET=desco_smart_prepaid_secure_jwt_secret_token_2025

# আউটগোয়িং ইমেইল অ্যালার্ট (SMTP Settings)
# Gmail ব্যবহার করলে: smtp.gmail.com, Port: 587, এবং Google App Password দিন
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@notifications.desco.org.bd
SMTP_PASSWORD=your_smtp_app_password
SMTP_FROM_NAME="DESCO Smart Balance Alert"
SMTP_FROM_EMAIL="notifications@desco.org.bd"
SMTP_USE_TLS=true

# ক্রন ও অটোমেশন সেটিংস
ALERT_COOLDOWN_HOURS=6
SIMULATE_EMAIL_IF_OFFLINE=true
